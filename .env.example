# Example environment variables for the Ooge Hydrogen storefront.
# Copy this file to `.env` and fill in real values, OR run:
#   npx shopify hydrogen env pull
# to populate `.env` automatically from your linked Oxygen storefront.
#
# NOTE: `.env` is gitignored and must NEVER be committed — it holds live secrets.
# These keys are required for the app to run:

# Shopify Storefront API
PUBLIC_STOREFRONT_ID=
PUBLIC_STOREFRONT_API_TOKEN=
PUBLIC_STORE_DOMAIN=your-shop.myshopify.com
PRIVATE_STOREFRONT_API_TOKEN=

# Customer Account API
PUBLIC_CUSTOMER_ACCOUNT_API_CLIENT_ID=
PUBLIC_CUSTOMER_ACCOUNT_API_URL=

# Shop / session
SHOP_ID=
SESSION_SECRET=

# Optional: set to "true" to take the whole storefront offline behind a branded
# "We'll be right back" maintenance page (HTTP 503). Leave blank/unset for normal
# operation. See app/lib/maintenance.ts.
MAINTENANCE_MODE=

# ── Contact form: lead storage ────────────────────────────────────────────────
# Leads are appended to a Google Sheet via an Apps Script web app.
# Setup instructions are at the top of scripts/contact-lead-sheet.gs.
# The /exec URL of the deployed Apps Script web app:
CONTACT_SHEET_WEBHOOK_URL=
# Must match the SHARED_TOKEN script property in that Apps Script project:
CONTACT_SHEET_TOKEN=

# ── Contact form: WhatsApp acknowledgement (Netcore CPaaS) ────────────────────
# Netcore WhatsApp API key (sent as a Bearer token). Dashboard:
# https://cpaas.netcorecloud.com → Settings → API.
NETCORE_WA_API_KEY=
# Netcore "source" id — a UUID from the WhatsApp dashboard, sent with each
# message (e.g. 461089f9-1000-4211-b182-c7f0291f3d45). Optional but recommended.
NETCORE_WA_SOURCE_ID=
# Name of your APPROVED WhatsApp template. It must have a DOCUMENT header so the
# catalogue PDF can ride along. Leave blank to disable the WhatsApp step.
NETCORE_WA_TEMPLATE_NAME=
# Template language code as registered with Meta, e.g. en or en_US
NETCORE_WA_TEMPLATE_LANG=en
# Publicly reachable HTTPS URL of the catalogue PDF. If you drop the file at
# public/catalogue/ooge-catalogue.pdf this is https://<your-domain>/catalogue/ooge-catalogue.pdf
CONTACT_CATALOGUE_PDF_URL=
# Filename the recipient sees in WhatsApp:
CONTACT_CATALOGUE_PDF_FILENAME=Ooge-Catalogue.pdf
# Country code prefixed to numbers entered without one (91 = India):
CONTACT_DEFAULT_COUNTRY_CODE=91
